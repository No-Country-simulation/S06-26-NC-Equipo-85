{
  "extends": "@appbit/typescript-config/react-library.json",
  "compilerOptions": {
    "paths": {
      "@appbit/ui/components/*": ["./src/components/ui/*"],
      "@appbit/ui/lib/*": ["./src/lib/*"],
      "@appbit/ui/atoms/*": ["./src/atoms/*"],
      "@appbit/ui/molecules/*": ["./src/molecules/*"],
      "@appbit/ui/organisms/*": ["./src/organisms/*"]
    }
  },
  "include": ["src", ".storybook"],
  "exclude": ["node_modules", "storybook-static"]
}
