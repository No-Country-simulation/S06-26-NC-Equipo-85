{
  "name": "s06-26-nc-equipo-85",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend monorepo for No Country S06-26 Equipo 85.",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,css}\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:build": "docker compose -f infra/docker-compose.yml build",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "turbo": "2.9.16"
  },
  "packageManager": "pnpm@11.5.2"
}